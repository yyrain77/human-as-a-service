# 服务运行端口（Zeabur 会自动注入 PORT，默认 3000）
PORT=3000

# 模型名称：朋友客户端填写的模型名，支持自定义（如 gugu-bot, deepseek-human, my-ai）
MODEL_NAME=gugu-bot

# 朋友调用接口的密码/API Key（留空则不设防任何人可调，推荐设置如 sk-123456 或 0111）
API_KEY=0111

# 控制台管理员密码（手机打开 /admin 网页工作台时的登录口令，防止外人偷窥）
ADMIN_PASSWORD=your_secure_admin_password

# Telegram 机器人 Token（通过 @BotFather 获取，用于手机锁屏秒推通知）
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 你的 Telegram 数字 User ID（通过 @userinfobot 获取，只有此 ID 能收到通知和回复）
TELEGRAM_ADMIN_CHAT_ID=123456789

# 数据持久化目录（挂载 Zeabur Volume 路径，默认为 /app/data）
DATA_DIR=/app/data

# 等待你真人打字回复的超时时间（秒），默认 600 秒（10 分钟）
REPLY_TIMEOUT_SECONDS=600

# 超过时间未回复时的自动兜底台词
TIMEOUT_FALLBACK_TEXT=（大模型算力节点过热，思考超时啦，请再问一次试试～）
